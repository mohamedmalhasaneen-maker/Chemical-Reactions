{
  "entities": {
    "LabProfile": {
      "title": "LabProfile",
      "description": "Authenticated student laboratory profile, XP progress, badges, and completed lessons",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the student"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Student public display name"
        },
        "scorePoints": {
          "type": "integer",
          "description": "Total earned academic XP points"
        },
        "completedLessons": {
          "type": "array",
          "description": "Bounded list of completed lesson IDs (max 50)"
        },
        "unlockedBadges": {
          "type": "array",
          "description": "Bounded list of unlocked badge IDs (max 50)"
        },
        "experimentsRun": {
          "type": "integer",
          "description": "Total number of simulated chemical reactions"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "scorePoints",
        "completedLessons",
        "unlockedBadges",
        "experimentsRun",
        "createdAt",
        "updatedAt"
      ]
    },
    "Comment": {
      "title": "Comment",
      "description": "Visitor comment record",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "comment": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "rating": {
          "type": "integer"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["name", "comment", "rating", "productId", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog item",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "price": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "stock": {
          "type": "integer"
        }
      },
      "required": ["name", "price", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Legacy order record",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "totalAmount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["ownerId", "totalAmount", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Developer or Admin authorization record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["developer", "admin"]
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/lab_profiles/{userId}": {
      "schema": { "$ref": "#/entities/LabProfile" },
      "description": "Authenticated student chemistry lab progression and achievement records"
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Legacy visitor comments collection"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Legacy products collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Legacy orders collection"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized platform administrators"
    }
  }
}
