{
  "entities": {
    "Comment": {
      "title": "Comment",
      "description": "Product review or customer comment submitted by visitors",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Visitor name or alias"
        },
        "comment": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500,
          "description": "Comment text content"
        },
        "rating": {
          "type": "integer",
          "description": "Star rating from 1 to 5"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Target product ID"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Approval status of the comment"
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp"
        }
      },
      "required": ["name", "comment", "rating", "productId", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Store item catalog product",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "description": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "category": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "stock": {
          "type": "integer"
        }
      },
      "required": ["name", "price", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string"
        },
        "customerPhone": {
          "type": "string"
        },
        "customerAddress": {
          "type": "string"
        },
        "totalAmount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["customerName", "customerPhone", "customerAddress", "totalAmount", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Developer or Admin authorization record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["developer", "admin"]
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Collection of visitor comments and product ratings"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "E-commerce products catalog"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized developers and store administrators"
    }
  }
}
